# ==============================================================================
# VTOP Automation Configuration
# Rename this file to .env and replace placeholders with your credentials.
# ==============================================================================

# Your VTOP Student Registration Number / Login ID (e.g. 21BCE0001)
VTOP_USERNAME=YOUR_REG_NUMBER

# Your VTOP Account Password
VTOP_PASSWORD=YOUR_PASSWORD

# Target Facility to register for (Exact row name or substring in Facility Registration)
# Common options: "Swimming Men", "Swimming Women", "Gym Men", "Gym Women", "Badminton Men"
TARGET_FACILITY=Swimming Men
